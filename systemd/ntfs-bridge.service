# NTFS-ext4 bridge systemd unit (template)
#
# Install: copy to /etc/systemd/system/ntfs-bridge.service, adjust paths,
# then: systemctl daemon-reload && systemctl enable --now ntfs-bridge
#
# IMPORTANT: set RequiresMountsFor= to the real filesystem(s) your source
# directory's data lives on (including symlink targets). local-fs.target is
# NOT enough when the data disk mounts late (encrypted disks, USB, network
# unlock): without this dependency the bridge can start against dangling
# symlinks and serve an empty volume. The bridge also refuses to start in
# that state (dangling-symlink and MFT-tracking guards), and Restart=
# below retries until the mount appears.

[Unit]
Description=NTFS-ext4 bridge (NBD server)
After=local-fs.target network-online.target
Wants=network-online.target
# One line per filesystem. A source dir of symlinks usually spans more
# than one disk, and listing only some of them is the easy mistake.
# The bridge no longer depends on getting this right: it waits for its
# own source roots to resolve (--source-wait, default 300s). These
# lines still help systemd order the start without the bridge spinning.
RequiresMountsFor=/srv/CHANGE-ME-data-mount
#RequiresMountsFor=/srv/CHANGE-ME-second-data-mount
Before=libvirtd.service

[Service]
Type=simple
WorkingDirectory=/opt/ntfs-ext4-bridge
ExecStart=/opt/ntfs-ext4-bridge/scripts/start_bridge_for_vm.sh
ExecStartPost=/bin/bash -c 'for i in $(seq 1 60); do ss -tln | grep -q ":10809 " && exit 0; sleep 1; done; echo "Bridge did not start listening on :10809 within 60s" >&2; exit 1'
# The first restart of the night wedged: stop killed the NBD server but left
# /dev/nbd0 attached with an ntfs-3g mount on it, and the next start ran a
# global sync() that blocked forever on the dead device. Whatever state the
# process is in when it dies, release the mount and the device before the
# next start. KillMode=mixed lets the bridge run its own stop() first.
ExecStopPost=/bin/sh -c 'fusermount -uz /mnt/ntfs-bridge 2>/dev/null; umount -l /mnt/ntfs-bridge 2>/dev/null; nbd-client -d /dev/nbd0 2>/dev/null; true'
KillMode=mixed
TimeoutStopSec=120
Restart=on-failure
RestartSec=30
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
